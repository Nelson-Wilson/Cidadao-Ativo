<%- include('../layouts/header') %>

<!-- Hero público -->
<section class="relative overflow-hidden rounded-3xl border border-blue-700/40 bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 text-white shadow-card">
    <div class="pointer-events-none absolute -right-16 -top-24 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-sky-400/20 blur-3xl"></div>

    <div class="relative grid gap-8 p-6 sm:p-10 lg:grid-cols-[1.25fr_1fr] lg:items-center">
        <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-blue-50 backdrop-blur">
                <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-300 opacity-70"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-300"></span>
                </span>
                Participação cívica digital · Maputo
            </span>

            <h1 class="mt-4 max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-[2.6rem]">
                Vê o que está a acontecer na tua cidade e ajuda a resolvê-lo.
            </h1>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-blue-100/90 sm:text-base">
                Buracos, iluminação, lixo, água ou esgotos: reporta com uma fotografia e acompanha
                em tempo real a intervenção das equipas do Conselho Municipal de Maputo.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-3">
                <a href="<%= url('/denuncias/nova') %>"
                   class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-blue-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-blue-50">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316zM16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
                    </svg>
                    Reportar um problema
                </a>
                <% if (!usuarioAtual) { %>
                    <a href="<%= url('/registar') %>"
                       class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15">
                        Criar conta gratuita
                    </a>
                <% } else { %>
                    <a href="<%= url('/denuncias') %>"
                       class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15">
                        As minhas ocorrências
                    </a>
                <% } %>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
                <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-blue-100/80">No mapa</p>
                <p class="mt-1 text-2xl font-bold" data-map-total>—</p>
                <p class="text-[10px] text-blue-100/70">ocorrências</p>
            </div>
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
                <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-blue-100/80">Em curso</p>
                <p class="mt-1 text-2xl font-bold text-sky-200" data-map-active>—</p>
                <p class="text-[10px] text-blue-100/70">no terreno</p>
            </div>
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
                <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-blue-100/80">Resolvidas</p>
                <p class="mt-1 text-2xl font-bold text-emerald-200" data-map-resolved>—</p>
                <p class="text-[10px] text-blue-100/70">concluídas</p>
            </div>
        </div>
    </div>

    <div class="relative grid gap-3 border-t border-white/15 px-6 py-5 sm:grid-cols-3 sm:px-10">
        <div class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-bold">1</span>
            <div>
                <p class="text-xs font-bold">Fotografa e localiza</p>
                <p class="text-[11px] text-blue-100/80">Uma foto clara e o pino no mapa.</p>
            </div>
        </div>
        <div class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-bold">2</span>
            <div>
                <p class="text-xs font-bold">Triagem municipal</p>
                <p class="text-[11px] text-blue-100/80">Encaminhamento para o departamento certo.</p>
            </div>
        </div>
        <div class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-bold">3</span>
            <div>
                <p class="text-xs font-bold">Resolução comprovada</p>
                <p class="text-[11px] text-blue-100/80">O técnico publica a foto da obra concluída.</p>
            </div>
        </div>
    </div>
</section>

<!-- Mapa e lista -->
<section class="mt-6 ca-card overflow-hidden">
    <div class="flex flex-col gap-4 border-b border-slate-100 p-5 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div>
            <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Mapa de ocorrências</h2>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Explora os problemas reportados e o estado atual de cada intervenção.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-[11px] font-medium text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-slate-400"></span>Recebida</span>
            <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>Em análise</span>
            <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-violet-500"></span>Atribuída</span>
            <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-sky-500"></span>Em execução</span>
            <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>Resolvida</span>
        </div>
    </div>

    <div class="border-b border-slate-100 bg-slate-50/60 p-5 dark:border-slate-800 dark:bg-slate-900/40 sm:p-6">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <label for="filter-category" class="ca-label">Categoria</label>
                <select id="filter-category" class="ca-input">
                    <option value="">Todas as categorias</option>
                    <% categories.forEach(function(category) { %>
                        <option value="<%= category.id %>"><%= category.name %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label for="filter-status" class="ca-label">Estado</label>
                <select id="filter-status" class="ca-input">
                    <option value="">Todos os estados</option>
                    <option value="recebida">Recebida</option>
                    <option value="em_analise">Em análise</option>
                    <option value="atribuida">Atribuída</option>
                    <option value="em_execucao">Em execução</option>
                    <option value="resolvida">Resolvida</option>
                    <option value="fechada">Fechada</option>
                </select>
            </div>

            <div class="flex items-end">
                <button id="btn-recenter" type="button" class="ca-btn-secondary w-full">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                    </svg>
                    Centrar em Maputo
                </button>
            </div>
        </div>
    </div>

    <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <div class="relative p-3 sm:p-4">
            <div id="reports-map" class="h-[420px] w-full sm:h-[560px]"></div>
            <div id="reports-loading" class="pointer-events-none absolute inset-3 flex items-center justify-center rounded-2xl bg-white/60 backdrop-blur-sm dark:bg-slate-950/60 sm:inset-4">
                <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    <span class="h-3 w-3 animate-spin rounded-full border-2 border-blue-500 border-t-transparent"></span>
                    A carregar ocorrências…
                </div>
            </div>
        </div>

        <aside class="border-t border-slate-100 p-4 dark:border-slate-800 lg:border-l lg:border-t-0">
            <div class="mb-3 flex items-center justify-between">
                <h3 class="ca-eyebrow">Ocorrências recentes</h3>
                <span class="ca-chip px-2 py-0.5"><span data-map-total>—</span></span>
            </div>

            <div id="reports-list" class="ca-no-scrollbar max-h-[480px] space-y-2 overflow-y-auto pr-0.5"></div>

            <div id="reports-empty" class="hidden rounded-xl border border-dashed border-slate-300 p-8 text-center dark:border-slate-700">
                <p class="text-2xl" aria-hidden="true">🌱</p>
                <p class="mt-2 text-sm font-semibold text-slate-700 dark:text-slate-200">Sem ocorrências para estes filtros</p>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Experimenta limpar a categoria ou o estado selecionado.</p>
            </div>

            <div id="reports-error" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-300">
                Não foi possível carregar o mapa agora. Recarrega a página para tentar novamente.
            </div>

            <div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 p-3 text-[11px] leading-relaxed text-blue-800 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-200">
                <strong class="font-bold">Problema já reportado?</strong>
                Ao criar uma nova denúncia perto de uma ocorrência igual, podes confirmar a existente em vez de duplicar.
            </div>
        </aside>
    </div>
</section>

<script src="<%= url('vendor/leaflet/leaflet.js') %>" defer></script>
<script src="<%= url('js/map.js') %>" defer></script>

<%- include('../layouts/footer') %>

<%- include('../../layouts/header') %>

<nav class="mb-5 flex items-center gap-2 text-xs font-medium text-slate-400 dark:text-slate-500" aria-label="Navegação estrutural">
    <a href="<%= url('/municipio/denuncias') %>" class="inline-flex items-center gap-1 transition hover:text-blue-600 dark:hover:text-blue-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
        Gestão de denúncias
    </a>
    <span aria-hidden="true">/</span>
    <span class="text-slate-700 dark:text-slate-200">#<%= report.id %></span>
</nav>

<header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-bold text-slate-400 dark:text-slate-500">#<%= report.id %></span>
            <span class="ca-badge <%= statusClasses(report.status) %>"><%= statusLabel(report.status) %></span>
            <span class="ca-badge <%= priorityClasses(report.priority) %>"><%= priorityLabel(report.priority) %></span>
        </div>
        <h1 class="ca-page-title mt-2"><%= report.category_name %></h1>
        <p class="ca-muted mt-1">
            <%= report.citizen_name %> · Bairro <%= report.neighborhood || 'não indicado' %> · <%= formatDateTime(report.created_at) %>
        </p>
    </div>
    <a href="https://www.openstreetmap.org/?mlat=<%= report.latitude %>&mlon=<%= report.longitude %>#map=18"
       target="_blank" rel="noopener noreferrer" class="ca-btn-secondary self-start">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
        Ver no mapa
    </a>
</header>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
    <!-- Detalhes -->
    <div class="space-y-5">
        <section class="ca-card ca-card-pad">
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Ocorrência reportada</h2>

            <% if (report.photo_path) { %>
                <img src="<%= url(report.photo_path) %>" alt="Fotografia da ocorrência <%= report.category_name %>" loading="lazy"
                     class="mt-4 max-h-96 w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700">
            <% } %>

            <div class="mt-4 rounded-xl border border-slate-100 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60">
                <p class="ca-eyebrow mb-1">Descrição</p>
                <p class="whitespace-pre-line text-sm leading-relaxed text-slate-700 dark:text-slate-300"><%- nl2br(report.description) %></p>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-2.5 text-xs">
                <div class="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Cidadão</dt>
                    <dd class="mt-0.5 font-semibold text-slate-800 dark:text-slate-100"><%= report.citizen_name %></dd>
                </div>
                <div class="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Bairro</dt>
                    <dd class="mt-0.5 font-semibold text-slate-800 dark:text-slate-100"><%= report.neighborhood || '—' %></dd>
                </div>
                <div class="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Departamento</dt>
                    <dd class="mt-0.5 font-semibold text-slate-800 dark:text-slate-100"><%= report.department_name || '—' %></dd>
                </div>
                <div class="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Técnico</dt>
                    <dd class="mt-0.5 font-semibold text-slate-800 dark:text-slate-100"><%= report.technician_name || 'Por atribuir' %></dd>
                </div>
                <div class="col-span-2 rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Coordenadas</dt>
                    <dd class="mt-0.5 font-mono font-semibold text-slate-700 dark:text-slate-200"><%= report.latitude %>, <%= report.longitude %></dd>
                </div>
            </dl>
        </section>

        <section class="ca-card ca-card-pad">
            <h2 class="flex items-center gap-2 font-display text-base font-bold text-slate-900 dark:text-white">
                <svg class="h-4 w-4 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Histórico de estados
            </h2>
            <ol class="relative mt-4 space-y-4 pl-5 before:absolute before:bottom-2 before:left-[0.3rem] before:top-2 before:w-px before:bg-slate-200 dark:before:bg-slate-700">
                <% history.forEach(function(entry) { %>
                    <li class="relative">
                        <span class="absolute -left-[1.05rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-blue-500 shadow-sm dark:border-slate-900"></span>
                        <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-3 dark:border-slate-800 dark:bg-slate-900/60">
                            <div class="flex flex-wrap items-center justify-between gap-1">
                                <strong class="text-xs font-bold text-slate-800 dark:text-slate-100"><%= statusLabel(entry.new_status) %></strong>
                                <span class="text-[10px] text-slate-400 dark:text-slate-500"><%= formatDateTime(entry.created_at) %></span>
                            </div>
                            <p class="mt-0.5 text-[10px] text-slate-400 dark:text-slate-500">Por <%= entry.changed_by_name || 'sistema' %></p>
                        </div>
                    </li>
                <% }) %>
            </ol>
        </section>
    </div>

    <!-- Ações -->
    <div class="space-y-5">
        <section class="ca-card ca-card-pad">
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Atribuir técnico</h2>
            <% if (!technicians.length) { %>
                <p class="mt-3 rounded-xl border border-dashed border-slate-200 p-4 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
                    Não há técnicos configurados para o departamento responsável por esta ocorrência.
                </p>
            <% } else { %>
                <form method="POST" action="<%= url('/municipio/denuncias/' + report.id + '/atribuir') %>" class="mt-3 space-y-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div>
                        <label for="technician_id" class="ca-label">Técnico responsável</label>
                        <select name="technician_id" id="technician_id" required class="ca-input">
                            <option value="">Escolher técnico</option>
                            <% technicians.forEach(function(tech) { %>
                                <option value="<%= tech.id %>" <%= report.technician_id === tech.id ? 'selected' : '' %>>
                                    <%= tech.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="ca-btn-primary w-full">Atribuir técnico</button>
                </form>
            <% } %>
        </section>

        <section class="ca-card ca-card-pad">
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Alterar estado</h2>
            <% if (!nextStates.length) { %>
                <p class="mt-3 rounded-xl border border-dashed border-slate-200 p-4 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
                    Este é um estado final — não existem transições possíveis.
                </p>
            <% } else { %>
                <form method="POST" action="<%= url('/municipio/denuncias/' + report.id + '/estado') %>" class="mt-3 space-y-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div>
                        <label for="status" class="ca-label">Novo estado</label>
                        <select name="status" id="status" required class="ca-input">
                            <% nextStates.forEach(function(next) { %>
                                <option value="<%= next %>"><%= statusLabel(next) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label for="response" class="ca-label">Resposta ao cidadão <span class="font-normal text-slate-400">(opcional)</span></label>
                        <textarea name="response" id="response" rows="2" placeholder="Ex.: Equipa enviada ao local." class="ca-input resize-y"></textarea>
                    </div>
                    <button type="submit" class="ca-btn-primary w-full">Atualizar estado</button>
                </form>
            <% } %>
        </section>

        <section class="rounded-2xl border border-blue-200 bg-blue-50/80 p-4 text-xs leading-relaxed text-blue-800 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-200">
            <strong class="block font-bold">Máquina de estados</strong>
            Cada alteração é validada e registada no histórico. Não é possível saltar etapas nem voltar atrás sem intervenção municipal.
        </section>
    </div>
</div>

<%- include('../../layouts/footer') %>

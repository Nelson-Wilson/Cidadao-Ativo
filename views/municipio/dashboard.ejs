<%- include('../layouts/header') %>

<header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-blue-700 dark:border-blue-800 dark:bg-blue-950/60 dark:text-blue-300">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>
            Gestão municipal
        </span>
        <h1 class="ca-page-title mt-2">Painel de controlo urbano</h1>
        <p class="ca-muted mt-1">Visão integrada das ocorrências e do desempenho das equipas no terreno.</p>
    </div>
    <a href="<%= url('/municipio/denuncias') %>" class="ca-btn-primary self-start sm:self-auto">
        Gerir ocorrências
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"/></svg>
    </a>
</header>

<% if (smartSummary) { %>
    <section class="mb-6 overflow-hidden rounded-2xl border border-violet-200 bg-gradient-to-r from-violet-50 via-white to-blue-50 p-5 shadow-soft dark:border-violet-900 dark:from-violet-950/40 dark:via-slate-900 dark:to-blue-950/30">
        <div class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet-600 to-indigo-600 text-white shadow-sm">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
            </span>
            <div>
                <h2 class="flex flex-wrap items-center gap-2 text-sm font-bold text-violet-900 dark:text-violet-200">
                    Boletim executivo
                    <span class="rounded-full border border-violet-300 bg-white/70 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-violet-700 dark:border-violet-700 dark:bg-violet-950/60 dark:text-violet-300">IA</span>
                </h2>
                <p class="mt-1 text-xs leading-relaxed text-slate-700 dark:text-slate-300 sm:text-sm"><%= smartSummary %></p>
            </div>
        </div>
    </section>
<% } %>

<!-- KPIs -->
<section class="grid grid-cols-2 gap-3 lg:grid-cols-5" aria-label="Indicadores principais">
    <div class="ca-card p-4">
        <div class="flex items-center justify-between">
            <span class="ca-eyebrow">Total</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>
            </span>
        </div>
        <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white"><%= stats.total %></p>
        <p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">Na plataforma</p>
    </div>

    <div class="ca-card p-4">
        <div class="flex items-center justify-between">
            <span class="ca-eyebrow">Hoje</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
            </span>
        </div>
        <p class="mt-2 text-3xl font-bold tracking-tight text-blue-600 dark:text-blue-400"><%= stats.hoje %></p>
        <p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">Últimas 24 horas</p>
    </div>

    <div class="ca-card border-amber-200 p-4 dark:border-amber-900/70">
        <div class="flex items-center justify-between">
            <span class="ca-eyebrow text-amber-600 dark:text-amber-400">Pendentes</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-950/60 dark:text-amber-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
        </div>
        <p class="mt-2 text-3xl font-bold tracking-tight text-amber-600 dark:text-amber-400"><%= stats.pendentes %></p>
        <p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">Por analisar / atribuir</p>
    </div>

    <div class="ca-card border-sky-200 p-4 dark:border-sky-900/70">
        <div class="flex items-center justify-between">
            <span class="ca-eyebrow text-sky-600 dark:text-sky-400">Em curso</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600 dark:bg-sky-950/60 dark:text-sky-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/></svg>
            </span>
        </div>
        <p class="mt-2 text-3xl font-bold tracking-tight text-sky-600 dark:text-sky-400"><%= stats.em_execucao %></p>
        <p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">Com técnicos no terreno</p>
    </div>

    <div class="ca-card col-span-2 border-emerald-200 p-4 dark:border-emerald-900/70 lg:col-span-1">
        <div class="flex items-center justify-between">
            <span class="ca-eyebrow text-emerald-600 dark:text-emerald-400">Resolvidas</span>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
        </div>
        <p class="mt-2 text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400"><%= stats.resolvidas %></p>
        <p class="mt-0.5 text-[11px] text-slate-400 dark:text-slate-500">Casos concluídos</p>
    </div>
</section>

<!-- Tempo médio e taxa -->
<% const taxaResolucao = stats.total ? Math.round((stats.resolvidas / stats.total) * 100) : 0; %>
<section class="mt-3 grid gap-3 lg:grid-cols-2">
    <div class="ca-card flex items-center justify-between gap-4 p-4">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
            <div>
                <p class="ca-eyebrow">Tempo médio de atendimento</p>
                <p class="mt-0.5 text-lg font-bold text-slate-900 dark:text-white">
                    <% if (stats.tempo_medio_horas !== null) { %>
                        <%= stats.tempo_medio_horas %> h
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">(~<%= Math.round((stats.tempo_medio_horas / 24) * 10) / 10 %> dias)</span>
                    <% } else { %>
                        <span class="text-sm font-medium text-slate-400 dark:text-slate-500">A recolher dados</span>
                    <% } %>
                </p>
            </div>
        </div>
        <span class="hidden text-right text-[11px] leading-tight text-slate-400 dark:text-slate-500 sm:block">Baseado em<br>casos concluídos</span>
    </div>

    <div class="ca-card p-4">
        <div class="flex items-center justify-between">
            <p class="ca-eyebrow">Taxa de resolução</p>
            <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400"><%= taxaResolucao %>%</span>
        </div>
        <div class="ca-progress mt-2.5">
            <div class="ca-progress-bar bg-emerald-500" style="width: <%= taxaResolucao %>%"></div>
        </div>
        <p class="mt-1.5 text-[11px] text-slate-400 dark:text-slate-500">
            <%= stats.resolvidas %> de <%= stats.total %> ocorrências resolvidas ou fechadas.
        </p>
    </div>
</section>

<!-- Destaques -->
<section class="mt-3 grid gap-3 md:grid-cols-2">
    <div class="ca-card ca-card-pad">
        <h2 class="flex items-center gap-2 font-display text-sm font-bold text-slate-900 dark:text-white">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/></svg>
            </span>
            Categorias mais frequentes
        </h2>

        <% if (!topCategories.length) { %>
            <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-500">Sem dados suficientes ainda.</p>
        <% } else { %>
            <div class="mt-4 space-y-3">
                <% topCategories.forEach(function(item) { %>
                    <% const pct = Math.min(100, Math.round((item.total / (stats.total || 1)) * 100)); %>
                    <div>
                        <div class="mb-1 flex items-center justify-between text-[11px]">
                            <span class="font-medium text-slate-700 dark:text-slate-300"><%= item.name %></span>
                            <span class="font-bold text-slate-500 dark:text-slate-400"><%= item.total %></span>
                        </div>
                        <div class="ca-progress h-1.5">
                            <div class="ca-progress-bar h-1.5" style="width: <%= pct %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <div class="ca-card ca-card-pad">
        <h2 class="flex items-center gap-2 font-display text-sm font-bold text-slate-900 dark:text-white">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-950/60 dark:text-violet-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            </span>
            Bairros com mais ocorrências
        </h2>

        <% if (!topNeighborhoods.length) { %>
            <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-500">Sem dados suficientes ainda.</p>
        <% } else { %>
            <div class="mt-4 space-y-3">
                <% topNeighborhoods.forEach(function(item) { %>
                    <% const pct = Math.min(100, Math.round((item.total / (stats.total || 1)) * 100)); %>
                    <div>
                        <div class="mb-1 flex items-center justify-between text-[11px]">
                            <span class="font-medium text-slate-700 dark:text-slate-300"><%= item.neighborhood %></span>
                            <span class="font-bold text-slate-500 dark:text-slate-400"><%= item.total %></span>
                        </div>
                        <div class="ca-progress h-1.5 bg-violet-100 dark:bg-violet-950/50">
                            <div class="ca-progress-bar h-1.5 bg-violet-500" style="width: <%= pct %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<!-- Heatmap -->
<section class="ca-card mt-3 overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-slate-100 p-5 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Mapa de densidade</h2>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Zonas com maior concentração de problemas reportados.</p>
        </div>
        <div class="flex items-center gap-2 text-[10px] font-medium text-slate-500 dark:text-slate-400" aria-label="Escala do mapa de calor">
            <span>Menos</span>
            <span class="h-2 w-24 rounded-full bg-gradient-to-r from-blue-500 via-emerald-500 via-50% to-rose-500"></span>
            <span>Mais</span>
        </div>
    </div>
    <div class="relative p-3 sm:p-4">
        <div id="heatmap" class="h-[380px] w-full rounded-xl border border-slate-200 dark:border-slate-700"
             data-points="<%= JSON.stringify(heatPoints.map(function(p) { return [parseFloat(p.latitude), parseFloat(p.longitude), 0.6]; })) %>"></div>
        <p id="heatmap-empty" class="absolute inset-0 m-auto hidden h-fit w-fit rounded-xl border border-dashed border-slate-300 bg-white/90 px-4 py-3 text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900/90 dark:text-slate-400">
            Ainda não existem coordenadas suficientes para desenhar o mapa de calor.
        </p>
    </div>
</section>

<script src="<%= url('vendor/leaflet/leaflet.js') %>" defer></script>
<script src="<%= url('vendor/leaflet/leaflet-heat.js') %>" defer></script>
<script src="<%= url('js/dashboard.js') %>" defer></script>

<%- include('../layouts/footer') %>

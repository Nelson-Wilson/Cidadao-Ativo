<!DOCTYPE html>
<html lang="pt" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="theme-color" content="#ffffff">
    <title>Cidadão Ativo — <%= typeof title !== 'undefined' ? title : 'Plataforma de Reporte Urbano' %></title>

    <script src="<%= url('js/theme-init.js') %>"></script>

    <link rel="stylesheet" href="<%= url('vendor/leaflet/leaflet.css') %>">
    <link rel="stylesheet" href="<%= url('css/app.css') %>">
    <link rel="stylesheet" href="<%= url('css/style.css') %>">
</head>
<body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100" data-api-base="<%= url('/api') %>">

<a href="#conteudo" class="ca-skip-link">Saltar para o conteúdo principal</a>

<%
    const pathAtual = typeof currentPath !== 'undefined' ? currentPath : '';
    const mapaAtivo = pathAtual === '/';
    const denunciasAtivo = pathAtual.indexOf('/denuncias') === 0;
    const dashboardAtivo = pathAtual.indexOf('/municipio/dashboard') === 0;
    const gestaoAtivo = pathAtual.indexOf('/municipio/denuncias') === 0;
    const tarefasAtivo = pathAtual.indexOf('/tecnico') === 0;
    const temStatus = typeof status !== 'undefined' && status;
    const temErros = typeof errors !== 'undefined' && errors && errors.length;
%>

<!-- Barra institucional -->
<div class="hidden border-b border-slate-800 bg-slate-900 text-slate-300 sm:block">
    <div class="mx-auto flex h-8 max-w-7xl items-center justify-between px-4 text-[11px] sm:px-6 lg:px-8">
        <div class="flex items-center gap-2.5">
            <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
            </span>
            <span class="font-medium text-slate-200">Conselho Municipal de Maputo</span>
            <span class="text-slate-600">·</span>
            <span>Plataforma de participação cívica</span>
        </div>
        <div class="flex items-center gap-4">
            <span class="flex items-center gap-1.5">
                <svg class="h-3 w-3 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 00-1.173.417l-.97 1.293a1.125 1.125 0 01-1.21.38 12.035 12.035 0 01-7.143-7.143 1.125 1.125 0 01.38-1.21l1.293-.97c.363-.272.53-.734.417-1.173L6.963 3.102A1.125 1.125 0 005.872 2.25H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
                Emergências: <strong class="font-semibold text-white">198</strong> · <strong class="font-semibold text-white">112</strong>
            </span>
        </div>
    </div>
</div>

<!-- Navegação principal -->
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/90">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between gap-3">
            <!-- Logótipo -->
            <a href="<%= url('/') %>" class="group flex shrink-0 items-center gap-2.5" aria-label="Cidadão Ativo — início">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 text-white shadow-sm shadow-blue-600/20 transition group-hover:scale-105">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-4.35 7-11a7 7 0 10-14 0c0 6.65 7 11 7 11z"/>
                        <circle cx="12" cy="10" r="2.5"/>
                    </svg>
                </span>
                <span class="hidden sm:block">
                    <span class="flex items-center gap-2">
                        <span class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">Cidadão Ativo</span>
                        <span class="hidden rounded-full border border-blue-100 bg-blue-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-blue-700 lg:inline dark:border-blue-800 dark:bg-blue-950/60 dark:text-blue-300">Maputo</span>
                    </span>
                    <span class="block text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Zeladoria e gestão urbana</span>
                </span>
            </a>

            <!-- Navegação desktop -->
            <nav class="hidden items-center gap-1 md:flex" aria-label="Navegação principal">
                <a href="<%= url('/') %>" class="ca-nav-link <%= mapaAtivo ? 'ca-nav-link-active' : '' %>">Mapa público</a>

                <% if (usuarioAtual) { %>
                    <% if (usuarioAtual.role === 'cidadao') { %>
                        <a href="<%= url('/denuncias') %>" class="ca-nav-link <%= denunciasAtivo && pathAtual === '/denuncias' ? 'ca-nav-link-active' : '' %>">As minhas denúncias</a>
                    <% } else if (usuarioAtual.role === 'tecnico') { %>
                        <a href="<%= url('/tecnico/tarefas') %>" class="ca-nav-link <%= tarefasAtivo ? 'ca-nav-link-active' : '' %>">Minhas tarefas</a>
                    <% } else if (usuarioAtual.role === 'municipio' || usuarioAtual.role === 'admin') { %>
                        <a href="<%= url('/municipio/dashboard') %>" class="ca-nav-link <%= dashboardAtivo ? 'ca-nav-link-active' : '' %>">Dashboard</a>
                        <a href="<%= url('/municipio/denuncias') %>" class="ca-nav-link <%= gestaoAtivo ? 'ca-nav-link-active' : '' %>">Gestão</a>
                    <% } %>
                <% } %>
            </nav>

            <!-- Ações -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <button type="button" data-chatbot-open
                        class="ca-btn-ghost hidden sm:inline-flex" title="Abrir assistente virtual" aria-label="Abrir assistente virtual">
                    <svg class="h-4 w-4 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/>
                    </svg>
                    <span class="hidden lg:inline">Assistente IA</span>
                </button>

                <button type="button" data-theme-toggle
                        class="ca-btn-ghost h-10 w-10 p-0" aria-label="Alternar tema" aria-pressed="false" title="Alternar tema">
                    <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0112 21.75 9.75 9.75 0 013.75 12c0-4.27 2.75-7.89 6.55-9.15a.75.75 0 01.95.95A7.5 7.5 0 0020.8 14.05a.75.75 0 01.95.95z"/>
                    </svg>
                    <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
                    </svg>
                </button>

                <% if (usuarioAtual) { %>
                    <% if (usuarioAtual.role === 'cidadao') { %>
                        <a href="<%= url('/denuncias/nova') %>" class="ca-btn-primary hidden sm:inline-flex">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                            </svg>
                            <span>Nova denúncia</span>
                        </a>
                    <% } %>

                    <details class="relative" data-dropdown>
                        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl border border-transparent p-1 transition hover:border-slate-200 hover:bg-slate-50 dark:hover:border-slate-700 dark:hover:bg-slate-800">
                            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-xs font-bold text-white shadow-sm">
                                <%= initials(usuarioAtual.name) %>
                            </span>
                            <span class="hidden text-left lg:block">
                                <span class="block max-w-[130px] truncate text-xs font-semibold text-slate-800 dark:text-slate-100"><%= usuarioAtual.name %></span>
                                <span class="block text-[10px] font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500"><%= roleLabel(usuarioAtual.role) %></span>
                            </span>
                            <svg class="hidden h-3.5 w-3.5 text-slate-400 lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                            </svg>
                        </summary>

                        <div class="absolute right-0 mt-2 w-64 origin-top-right rounded-2xl border border-slate-200 bg-white p-2 shadow-card dark:border-slate-800 dark:bg-slate-900">
                            <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-800/60">
                                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white"><%= usuarioAtual.name %></p>
                                <p class="truncate text-[11px] text-slate-500 dark:text-slate-400"><%= usuarioAtual.email %></p>
                                <span class="mt-2 inline-flex rounded-full border border-blue-200 bg-blue-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-blue-700 dark:border-blue-800 dark:bg-blue-950/60 dark:text-blue-300"><%= roleLabel(usuarioAtual.role) %></span>
                            </div>
                            <div class="mt-1.5 space-y-0.5">
                                <a href="<%= url('/dashboard') %>" class="flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                                    </svg>
                                    O meu painel
                                </a>
                                <form method="POST" action="<%= url('/logout') %>">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-rose-600 transition hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950/40">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"/>
                                        </svg>
                                        Terminar sessão
                                    </button>
                                </form>
                            </div>
                        </div>
                    </details>
                <% } else { %>
                    <a href="<%= url('/login') %>" class="ca-btn-ghost hidden sm:inline-flex">Entrar</a>
                    <a href="<%= url('/registar') %>" class="ca-btn-primary hidden sm:inline-flex">Criar conta</a>
                <% } %>

                <button type="button" data-mobile-menu-toggle
                        class="ca-btn-ghost h-10 w-10 p-0 md:hidden" aria-label="Abrir menu" aria-expanded="false">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Menu móvel -->
    <div data-mobile-menu class="hidden border-t border-slate-200 bg-white px-4 pb-5 pt-3 dark:border-slate-800 dark:bg-slate-900 md:hidden">
        <nav class="space-y-1" aria-label="Navegação móvel">
            <a href="<%= url('/') %>" class="block rounded-xl px-3 py-2.5 text-sm font-semibold <%= mapaAtivo ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">Mapa público</a>

            <% if (usuarioAtual) { %>
                <% if (usuarioAtual.role === 'cidadao') { %>
                    <a href="<%= url('/denuncias') %>" class="block rounded-xl px-3 py-2.5 text-sm font-semibold <%= denunciasAtivo && pathAtual === '/denuncias' ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">As minhas denúncias</a>
                    <a href="<%= url('/denuncias/nova') %>" class="ca-btn-primary mt-2 w-full">Nova denúncia</a>
                <% } else if (usuarioAtual.role === 'tecnico') { %>
                    <a href="<%= url('/tecnico/tarefas') %>" class="block rounded-xl px-3 py-2.5 text-sm font-semibold <%= tarefasAtivo ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">Minhas tarefas</a>
                <% } else { %>
                    <a href="<%= url('/municipio/dashboard') %>" class="block rounded-xl px-3 py-2.5 text-sm font-semibold <%= dashboardAtivo ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">Dashboard</a>
                    <a href="<%= url('/municipio/denuncias') %>" class="block rounded-xl px-3 py-2.5 text-sm font-semibold <%= gestaoAtivo ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">Gestão de denúncias</a>
                <% } %>

                <div class="my-3 border-t border-slate-200 pt-3 dark:border-slate-800">
                    <div class="flex items-center gap-3 px-1">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-xs font-bold text-white"><%= initials(usuarioAtual.name) %></span>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-slate-900 dark:text-white"><%= usuarioAtual.name %></p>
                            <p class="truncate text-[11px] text-slate-500 dark:text-slate-400"><%= roleLabel(usuarioAtual.role) %> · <%= usuarioAtual.email %></p>
                        </div>
                    </div>
                    <form method="POST" action="<%= url('/logout') %>" class="mt-2">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="w-full rounded-xl border border-rose-200 px-3 py-2 text-xs font-semibold text-rose-600 transition hover:bg-rose-50 dark:border-rose-900 dark:text-rose-400 dark:hover:bg-rose-950/40">Terminar sessão</button>
                    </form>
                </div>
            <% } else { %>
                <div class="grid grid-cols-2 gap-2 pt-2">
                    <a href="<%= url('/login') %>" class="ca-btn-secondary">Entrar</a>
                    <a href="<%= url('/registar') %>" class="ca-btn-primary">Criar conta</a>
                </div>
            <% } %>

            <button type="button" data-chatbot-open class="mt-1 flex w-full items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold text-violet-700 transition hover:bg-violet-50 dark:text-violet-300 dark:hover:bg-violet-950/40">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
                </svg>
                Assistente virtual
            </button>
        </nav>
    </div>
</header>

<!-- Mensagens flash -->
<% if (temStatus || temErros) { %>
    <div class="fixed right-4 top-20 z-[60] flex w-[min(92vw,26rem)] flex-col gap-2" aria-live="polite">
        <% if (temStatus) { %>
            <div data-toast class="ca-toast border-emerald-200 bg-emerald-50/95 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/90 dark:text-emerald-100">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                    </svg>
                </span>
                <p class="flex-1 text-sm font-medium leading-relaxed"><%= status %></p>
                <button type="button" data-dismiss class="rounded-lg p-1 text-emerald-700/70 transition hover:bg-emerald-100 hover:text-emerald-900 dark:text-emerald-300/70 dark:hover:bg-emerald-900" aria-label="Fechar aviso">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        <% } %>
        <% if (temErros) { %>
            <div data-toast role="alert" class="ca-toast border-rose-200 bg-rose-50/95 text-rose-900 dark:border-rose-800 dark:bg-rose-950/90 dark:text-rose-100">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rose-600 text-white">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008zM10.29 3.86L1.82 18a2.25 2.25 0 001.95 3.38h16.46a2.25 2.25 0 001.95-3.38L13.71 3.86a2.25 2.25 0 00-3.42 0z"/>
                    </svg>
                </span>
                <div class="flex-1">
                    <p class="text-sm font-semibold">Não foi possível concluir:</p>
                    <ul class="mt-1 list-disc space-y-0.5 pl-4 text-xs leading-relaxed">
                        <% errors.forEach(function(error) { %><li><%= error %></li><% }) %>
                    </ul>
                </div>
                <button type="button" data-dismiss class="rounded-lg p-1 text-rose-700/70 transition hover:bg-rose-100 hover:text-rose-900 dark:text-rose-300/70 dark:hover:bg-rose-900" aria-label="Fechar aviso">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        <% } %>
    </div>
<% } %>

<main id="conteudo" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 sm:py-8 lg:px-8">

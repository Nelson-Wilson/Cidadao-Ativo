<%- include('../../layouts/header') %>

<header class="mb-6">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-amber-700 dark:border-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
        Área técnica
    </span>
    <h1 class="ca-page-title mt-2">Painel de tarefas</h1>
    <p class="ca-muted mt-1">Ocorrências atribuídas à tua equipa para vistoria e intervenção no terreno.</p>
</header>

<section class="mb-3 flex items-center justify-between">
    <h2 class="flex items-center gap-2 font-display text-base font-bold text-slate-900 dark:text-white">
        <svg class="h-4 w-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/></svg>
        Tarefas ativas
        <span class="rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold text-white"><%= reports.length %></span>
    </h2>
</section>

<% if (!reports.length) { %>
    <div class="ca-card mb-6 flex flex-col items-center px-6 py-16 text-center">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-2xl dark:bg-emerald-950/40" aria-hidden="true">
            <svg class="h-7 w-7 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </span>
        <p class="mt-3 text-sm font-bold text-slate-800 dark:text-slate-100">Sem tarefas pendentes</p>
        <p class="mt-1 max-w-sm text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            Bom trabalho! As novas ocorrências atribuídas pelo município aparecerão aqui automaticamente.
        </p>
    </div>
<% } else { %>
    <div class="mb-8 grid grid-cols-1 gap-3 md:grid-cols-2">
        <% reports.forEach(function(report) { %>
            <article class="ca-card ca-card-hover flex flex-col justify-between p-4 sm:p-5">
                <div>
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <span class="font-mono text-[11px] font-bold text-slate-400 dark:text-slate-500">#<%= report.id %></span>
                        <div class="flex flex-wrap items-center gap-1.5">
                            <% if (report.priority === 'muito_urgente' || report.priority === 'urgente') { %>
                                <span class="ca-badge <%= priorityClasses(report.priority) %>"><%= priorityLabel(report.priority) %></span>
                            <% } %>
                            <span class="ca-badge <%= statusClasses(report.status) %>"><%= statusLabel(report.status) %></span>
                        </div>
                    </div>

                    <h3 class="flex items-center gap-2 font-display text-base font-bold text-slate-900 dark:text-white">
                        <span aria-hidden="true"><%= categoryIcon(report.category_name) %></span>
                        <span class="truncate"><%= report.category_name %></span>
                    </h3>

                    <p class="mt-1 line-clamp-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                        <%= excerpt(report.description, 180) %>
                    </p>
                </div>

                <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-[11px] dark:border-slate-800">
                    <span class="flex items-center gap-1 text-slate-500 dark:text-slate-400">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                        <%= report.neighborhood || 'Local no mapa' %>
                    </span>

                    <a href="<%= url('/tecnico/tarefas/' + report.id) %>" class="ca-btn-primary px-3 py-1.5 text-xs">
                        Ver e agir
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"/></svg>
                    </a>
                </div>
            </article>
        <% }) %>
    </div>
<% } %>

<% if (historico && historico.length) { %>
    <section class="ca-card overflow-hidden">
        <div class="border-b border-slate-100 px-5 py-4 dark:border-slate-800">
            <h2 class="flex items-center gap-2 font-display text-sm font-bold text-slate-900 dark:text-white">
                <span aria-hidden="true">🎉</span>
                Concluídas recentemente
            </h2>
        </div>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800">
            <% historico.forEach(function(report) { %>
                <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3 text-xs">
                    <span class="flex min-w-0 items-center gap-2.5">
                        <svg class="h-4 w-4 shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span class="truncate font-medium text-slate-700 dark:text-slate-200">#<%= report.id %> · <%= report.category_name %></span>
                        <span class="hidden text-slate-400 dark:text-slate-500 sm:inline">(<%= report.neighborhood || 'Maputo' %>)</span>
                    </span>
                    <span class="ca-badge <%= statusClasses(report.status) %>"><%= statusLabel(report.status) %></span>
                </li>
            <% }) %>
        </ul>
    </section>
<% } %>

<%- include('../../layouts/footer') %>

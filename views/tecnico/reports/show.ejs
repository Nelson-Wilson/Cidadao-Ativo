<%- include('../../layouts/header') %>

<nav class="mb-5 flex items-center gap-2 text-xs font-medium text-slate-400 dark:text-slate-500" aria-label="Navegação estrutural">
    <a href="<%= url('/tecnico/tarefas') %>" class="inline-flex items-center gap-1 transition hover:text-blue-600 dark:hover:text-blue-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
        Minhas tarefas
    </a>
    <span aria-hidden="true">/</span>
    <span class="text-slate-700 dark:text-slate-200">Tarefa #<%= report.id %></span>
</nav>

<header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-bold text-slate-400 dark:text-slate-500">#<%= report.id %></span>
            <span class="ca-badge <%= statusClasses(report.status) %>"><%= statusLabel(report.status) %></span>
            <span class="ca-badge <%= priorityClasses(report.priority) %>"><%= priorityLabel(report.priority) %></span>
        </div>
        <h1 class="ca-page-title mt-2"><%= report.category_name %></h1>
        <p class="ca-muted mt-1">
            Bairro <%= report.neighborhood || 'Maputo' %> · <%= formatDateTime(report.created_at) %>
        </p>
    </div>
    <a href="https://www.google.com/maps/search/?api=1&query=<%= report.latitude %>,<%= report.longitude %>"
       target="_blank" rel="noopener noreferrer" class="ca-btn-secondary self-start">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
        Navegar
    </a>
</header>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
    <!-- Informação -->
    <div class="space-y-5">
        <section class="ca-card ca-card-pad">
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Fotografia do cidadão</h2>
            <% if (report.photo_path) { %>
                <img src="<%= url(report.photo_path) %>" alt="Fotografia da ocorrência <%= report.category_name %>" loading="lazy"
                     class="mt-3 max-h-96 w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700">
            <% } else { %>
                <p class="mt-3 rounded-xl border border-dashed border-slate-200 p-4 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">Sem fotografia anexada.</p>
            <% } %>

            <% if (summary && summary !== report.description) { %>
                <div class="mt-4 rounded-xl border border-violet-200 bg-violet-50/80 p-4 text-xs leading-relaxed text-violet-900 dark:border-violet-900 dark:bg-violet-950/40 dark:text-violet-200">
                    <span class="flex items-center gap-1.5 font-bold">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
                        Resumo rápido da IA
                    </span>
                    <p class="mt-1"><%= summary %></p>
                </div>
            <% } %>

            <div class="mt-4 rounded-xl border border-slate-100 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60">
                <p class="ca-eyebrow mb-1">Descrição completa</p>
                <p class="whitespace-pre-line text-sm leading-relaxed text-slate-700 dark:text-slate-300"><%- nl2br(report.description) %></p>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-2.5 text-xs">
                <div class="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Cidadão</dt>
                    <dd class="mt-0.5 font-semibold text-slate-800 dark:text-slate-100"><%= report.citizen_name %></dd>
                </div>
                <div class="rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Departamento</dt>
                    <dd class="mt-0.5 font-semibold text-slate-800 dark:text-slate-100"><%= report.department_name || '—' %></dd>
                </div>
                <div class="col-span-2 rounded-xl border border-slate-100 p-3 dark:border-slate-800">
                    <dt class="font-medium text-slate-400 dark:text-slate-500">Coordenadas GPS</dt>
                    <dd class="mt-0.5 font-mono font-semibold text-slate-700 dark:text-slate-200"><%= report.latitude %>, <%= report.longitude %></dd>
                </div>
            </dl>
        </section>
    </div>

    <!-- Ações -->
    <div class="space-y-5">
        <% if (report.status === 'atribuida') { %>
            <section class="ca-card ca-card-pad">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>
                </span>
                <h2 class="mt-3 font-display text-lg font-bold text-slate-900 dark:text-white">Pronto para iniciar?</h2>
                <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                    Ao iniciares a execução, o cidadão é notificado de que a equipa técnica está a caminho ou já iniciou a intervenção.
                </p>
                <form method="POST" action="<%= url('/tecnico/tarefas/' + report.id + '/iniciar') %>" class="mt-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="ca-btn-primary w-full">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"/></svg>
                        Iniciar Execução
                    </button>
                </form>
            </section>
        <% } %>

        <% if (report.status === 'em_execucao') { %>
            <section class="ca-card ca-card-pad">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316zM16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/></svg>
                </span>
                <h2 class="mt-3 font-display text-lg font-bold text-slate-900 dark:text-white">Comprovar resolução</h2>
                <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                    Fotografa o problema resolvido para arquivo oficial e notificação do munícipe.
                </p>

                <form method="POST" action="<%= url('/tecnico/tarefas/' + report.id + '/resolver') %>"
                      enctype="multipart/form-data" class="mt-4 space-y-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div>
                        <label for="photo" class="ca-label">Fotografia da resolução <span class="text-rose-500">*</span></label>
                        <input type="file" name="photo" id="photo" accept="image/jpeg,image/png,image/webp" capture="environment" required
                               class="block w-full cursor-pointer text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-slate-700 hover:file:bg-slate-200 dark:text-slate-300 dark:file:bg-slate-800 dark:file:text-slate-200 dark:hover:file:bg-slate-700">
                        <p class="mt-1 text-[10px] text-slate-400 dark:text-slate-500">JPG, PNG ou WebP · máximo 5 MB</p>
                    </div>

                    <div>
                        <label for="note" class="ca-label">Observações da intervenção <span class="font-normal text-slate-400">(opcional)</span></label>
                        <textarea name="note" id="note" rows="2" placeholder="Ex.: Buraco tapado com asfalto frio; lâmpada LED substituída…" class="ca-input resize-y"></textarea>
                    </div>

                    <button type="submit" class="ca-btn-primary w-full bg-emerald-600 hover:bg-emerald-700 focus-visible:ring-emerald-500/20">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                        Marcar como resolvida
                    </button>
                </form>
            </section>
        <% } %>

        <% if (report.status === 'resolvida' || report.status === 'fechada') { %>
            <section class="rounded-2xl border border-emerald-200 bg-emerald-50/80 p-6 text-center dark:border-emerald-900 dark:bg-emerald-950/40">
                <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600 dark:bg-emerald-900/60 dark:text-emerald-300">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </span>
                <h2 class="mt-3 font-display text-lg font-bold text-emerald-900 dark:text-emerald-200">Ocorrência concluída</h2>
                <p class="mt-1 text-xs leading-relaxed text-emerald-700 dark:text-emerald-300">
                    Esta denúncia foi dada como resolvida e arquivada com sucesso pela equipa técnica.
                </p>
            </section>
        <% } %>

        <% if (report.status === 'rejeitada') { %>
            <section class="rounded-2xl border border-rose-200 bg-rose-50/80 p-6 text-center dark:border-rose-900 dark:bg-rose-950/40">
                <h2 class="font-display text-lg font-bold text-rose-900 dark:text-rose-200">Ocorrência rejeitada</h2>
                <p class="mt-1 text-xs leading-relaxed text-rose-700 dark:text-rose-300">
                    Esta denúncia foi rejeitada pelo município e não requer intervenção técnica.
                </p>
            </section>
        <% } %>

        <section class="ca-card ca-card-pad">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-100">Checklist de intervenção</h2>
            <ul class="mt-3 space-y-2 text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
                <li class="flex items-start gap-2"><span class="mt-0.5 text-blue-500">•</span> Confirma a localização no mapa antes de sair.</li>
                <li class="flex items-start gap-2"><span class="mt-0.5 text-blue-500">•</span> Usa equipamento de proteção adequado ao tipo de ocorrência.</li>
                <li class="flex items-start gap-2"><span class="mt-0.5 text-blue-500">•</span> Fotografa o local depois da intervenção, com boa luz.</li>
            </ul>
        </section>
    </div>
</div>

<%- include('../../layouts/footer') %>

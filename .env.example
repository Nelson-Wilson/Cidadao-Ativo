# --- Aplicação ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Gera com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troca-isto-por-uma-string-aleatoria-longa

# --- Base de dados MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cidadao_ativo
DB_USERNAME=root
DB_PASSWORD=
# Em serviços geridos (TiDB Cloud, Aiven, Railway, etc.) ativa TLS.
DB_SSL=false

# Confia no primeiro proxy reverso (Render, Railway, Fly, etc.) para obter
# o IP real do cliente e servir cookies seguros atrás de HTTPS.
TRUST_PROXY=1

# --- Armazenamento de fotografias ---
# local = public/uploads (desenvolvimento; o disco do Render free é efémero)
# supabase = Supabase Storage (recomendado em produção)
STORAGE_DRIVER=local
# Só necessários com STORAGE_DRIVER=supabase. A chave service_role é secreta:
# nunca a coloques em código, no browser ou em repositórios públicos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cidadao-ativo

# --- Assistente e visão por IA (Google Gemini) ---
# Obtém uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
# Modelo free tier com visão (texto + imagem). O gemini-2.5-flash está
# depreciado e será encaminhado para o 3.5 Flash-Lite em 01/12/2026.
# 3.6 Flash: boa qualidade multimodal e latência baixa.
AI_MODEL=gemini-3.6-flash
# Usado automaticamente se o principal devolver 404/429/503 ou expirar.
AI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Nível de raciocínio dos modelos Gemini 3+ (conforme o modelo):
# MINIMAL, LOW, MEDIUM ou HIGH. Vazio desativa thinkingConfig; LOW é o
# equilíbrio para respostas curtas.
AI_THINKING_LEVEL=LOW

# Liga/desliga funcionalidades. Classificação, duplicados, resumo e prioridade
# são determinísticos; apenas o chatbot e a análise de fotografia usam Gemini.
AI_FEATURE_CLASSIFICATION=true
AI_FEATURE_DUPLICATES=true
AI_FEATURE_SUMMARY=true
AI_FEATURE_PRIORITY=true
AI_FEATURE_CHATBOT=true
AI_FEATURE_SMART_DASHBOARD=true
AI_FEATURE_PHOTO_ANALYSIS=true
AI_DUPLICATE_RADIUS_KM=0.3

# --- Dados de demonstração ---
# Usada apenas por `npm run seed`. Em produção, define uma password forte.
SEED_PASSWORD=

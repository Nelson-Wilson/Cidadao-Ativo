{
  "name": "cidadao-ativo",
  "version": "1.0.0",
  "description": "Cidadão Ativo — plataforma de reporte urbano (Node.js + Express + MySQL, sem framework pesado)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node database/seed.js",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.unit.js",
    "test:integration": "cross-env NODE_ENV=test DB_DATABASE=cidadao_ativo_test jest --config jest.config.integration.js --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.unit.js --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.5",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.5"
  },
  "overrides": {
    "qs": "^6.17.1",
    "express-mysql-session": {
      "mysql2": "^3.24.6"
    }
  }
}
